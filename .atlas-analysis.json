  "keyFeatures": [
    "Privacy-first analytics — no cookies, no personal data collected",
    "Real-time traffic dashboard with pageviews, visitors, bounce rate, and session duration",
    "Custom event tracking via data attributes or JavaScript API",
    "Funnel analysis to identify where users drop off before converting",
    "Goals tracking to measure conversion rates for pages and events",
    "Attribution reporting with first-click and last-click models",
    "Cohort analysis and segments for behavioral comparison over time",
    "Filters across URL, location, UTM, browser, and custom event properties",
    "Period comparison (previous period or year-over-year)",
    "Breakdown reports to segment data by any dimension",
    "Distinct ID user identification across sessions and devices",
    "Session replay to watch how individual users navigate",
    "Email reports with scheduled website summaries",
    "Teams with role-based access control",
    "White-label share pages for agencies and clients",
    "MCP server integration with AI tools (Claude, ChatGPT, Cursor)",
    "REST API with API key authentication",
    "Official @umami/api-client TypeScript library"
  ],
  "publicApiSurface": [
    "POST /api/auth/login",
